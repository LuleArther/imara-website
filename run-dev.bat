@echo off
REM ============================================================
REM  Imara website - run locally on Windows
REM  Double-click this file. Then open http://127.0.0.1:8090
REM  Staff dashboard: http://127.0.0.1:8090/admin/
REM ============================================================
cd /d "%~dp0"

where php >nul 2>nul
if errorlevel 1 (
  echo PHP is not installed. Install it with:  winget install PHP.PHP.8.3
  pause
  exit /b 1
)
for /f "delims=" %%i in ('where php') do (set "PHPEXE=%%i" & goto :found)
:found
for %%F in ("%PHPEXE%") do set "PHPDIR=%%~dpF"

if not exist dev mkdir dev
(
  echo ; generated by run-dev.bat - local testing only
  echo extension_dir = "%PHPDIR%ext"
  echo extension=pdo_sqlite
  echo extension=sqlite3
  echo extension=mbstring
  echo extension=openssl
  echo extension=curl
  echo extension=fileinfo
  echo display_errors = On
  echo date.timezone = Africa/Kampala
) > dev\php.ini

where python >nul 2>nul && python tools\build.py

if not exist app\config.local.php (
  echo.
  echo First run: creating a local test setup...
  php -c dev\php.ini tools\setup.php --dev
)

echo.
echo  Website:   http://127.0.0.1:8090
echo  Dashboard: http://127.0.0.1:8090/admin/
echo  Press Ctrl+C to stop.
echo.
start "" http://127.0.0.1:8090
php -c dev\php.ini -S 127.0.0.1:8090 -t public
